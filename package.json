{
  "name": "dsh-plugin-conversation-delete",
  "version": "1.1.0",
  "private": true,
  "description": "会话行“...”菜单里的对话工具箱：导出对话、导入对话、打开对话文件位置、删除对话（含磁盘文件）。",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": {
      "default": "./index.js"
    },
    "./client": {
      "default": "./client.js"
    },
    "./format": {
      "default": "./format.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "meta": {
    "title": "对话工具箱（导出 / 导入 / 定位 / 删除）",
    "description": "右键会话行的“...”菜单即可导出对话、把导出的对话导回来、在文件管理器里定位它的文件，或删除它及其磁盘文件。"
  },
  "icon": "./icon.svg",
  "files": [
    "index.js",
    "client.js",
    "format.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "session",
    "conversation",
    "export",
    "import",
    "reveal",
    "delete"
  ],
  "license": "MIT"
}
